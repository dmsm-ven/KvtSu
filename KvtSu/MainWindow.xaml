<Window
    x:Class="KvtSu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KvtSu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <GroupBox Header="Парсинг">
                <StackPanel>
                    <Button
                        x:Name="btnParseFromFile"
                        Click="btnParseBrand_Click"
                        Content="Парсинг артикулов из файла sku__list.txt" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Ресурсы">
                <StackPanel>
                    <Button
                        x:Name="btnDownloadResources"
                        Click="btnDownloadResources_Click"
                        Content="Скачать ресурсы" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Экспорт">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="2,2,8,2"
                            VerticalAlignment="Center"
                            Text="pid" />
                        <TextBox
                            x:Name="txtProductId"
                            Width="50"
                            Margin="2,2,8,2"
                            VerticalContentAlignment="Center"
                            Text="-1" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btnGeneralExport"
                            Click="btnGeneralExport_Click"
                            Content="Товары" />
                        <Button
                            x:Name="btnAdditionalImages"
                            Click="btnAdditionalImages_Click"
                            Content="Изображения" />
                        <Button
                            x:Name="btnFillDescriptions"
                            Click="btnFillDescriptions_Click"
                            Content="SQL описание" />
                        <Button
                            x:Name="btnImagesSql"
                            Click="btnImagesSql_Click"
                            Content="SQL изображения" />
                        <Button
                            x:Name="btnFillAdjacent"
                            Click="btnFillAdjacent_Click"
                            Content="Adjacent" />
                        <Button
                            x:Name="btnFillDimensions"
                            Click="btnFillDimensions_Click"
                            Content="Dimensions" />
                        <Button
                            x:Name="btnRawHtmlToDescription"
                            Click="btnRawHtmlToDescription_Click"
                            Content="Raw HTML to Desc Markup" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btnFillDescriptionsSingle"
                            Click="btnFillDescriptionsSingle_Click"
                            Content="SQL описание (новые товары)" />
                    </StackPanel>

                </StackPanel>
            </GroupBox>
        </StackPanel>

        <ProgressBar
            x:Name="pbIndicator"
            Grid.Row="1"
            Height="14"
            Margin="2"
            Maximum="1"
            Minimum="0"
            Value="0" />
    </Grid>
</Window>
